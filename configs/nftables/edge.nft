#!/usr/sbin/nft -f
# =============================================================================
# EDGE FIREWALL – BEISPIEL für NODE 0 / SEC-CORE (nftables)
# =============================================================================
# ⚠️  KRITISCH: Vor dem Laden IMMER aus einer IPMI-/Konsolen-Session arbeiten!
#     Eine falsche Regel sperrt dich aus. Zuerst:  nft -c -f edge.nft
# ⚠️  Alle Adressen/Interfaces sind <<PLACEHOLDER>> – anpassen!
# =============================================================================

flush ruleset

# --- Definitionen -----------------------------------------------------------
define IF_WAN     = <<eth_wan>>          # z. B. eth0 Richtung Firewalla (VLAN 100)
define IF_MGMT    = <<eth_mgmt>>         # Richtung VLAN 10
define IF_DMZ     = <<eth_dmz>>          # VLAN 50
define IF_LAB     = <<eth_lab>>          # VLAN 60
define IF_ANA     = <<eth_ana>>          # VLAN 80

define NET_MGMT   = 10.10.10.0/24
define NET_OOB    = 10.10.20.0/24
define NET_DMZ    = 10.10.50.0/24
define NET_LAB    = 10.10.60.0/24
define NET_ANA    = 10.10.80.0/24
define NET_ADMIN  = 10.10.10.50/32       # Admin-Workstation / VPN-Endpoint

define PORT_SSH   = 22
define PORT_PVE   = 8006

table inet filter {

  # --- Sets (dynamisch befüllbar, z. B. via fail2ban/crowdsec) -------------
  set blacklist4 {
    type ipv4_addr
    flags timeout
    timeout 1h
  }
  set whitelist_admin {
    type ipv4_addr
    elements = { $NET_ADMIN }
  }
  set honey_ports {
    type inet_service
    elements = { 2222, 2223 }   # Cowrie, nicht Host-SSH!
  }

  # --- Chains ---------------------------------------------------------------
  chain input {
    type filter hook input priority filter; policy drop;

    # Basis
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # ICMPv6 Neighbor Discovery (nötig für IPv6; bei reinem IPv4 entfernen)
    ip6 nexthdr icmpv6 icmpv6 type { nd-neighbor-solicit, nd-router-advert, nd-neighbor-advert } accept

    # Blacklist
    ip saddr @blacklist4 counter drop

    # Admin-Zugriff auf die Firewall selbst (nur aus Whitelist)
    ip saddr @whitelist_admin tcp dport { $PORT_SSH, $PORT_PVE } accept
    ip saddr @whitelist_admin icmp type echo-request limit rate 5/second accept

    # Alles andere zur Firewall selbst: drop + log
    jump drop_log
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    ct state established,related accept
    ct state invalid drop
    ip saddr @blacklist4 counter drop

    # --- WAN → DMZ: nur Honeypot-Ports (Cowrie) ---------------------------
    iifname $IF_WAN oifname $IF_DMZ tcp dport @honey_ports counter accept

    # --- DMZ Egress: STARK limitieren (kompromittierter Honeypot!) --------
    # Erlaubt: DNS + NTP zu internen Resolvern; KEIN freies Internet
    iifname $IF_DMZ oifname $IF_ANA tcp dport { 514, 6514 } accept   # Logs → Analytics/Syslog
    iifname $IF_DMZ oifname $IF_WAN udp dport { 53, 123 } \
      ip daddr { <<DNS_RESOLVER>>, <<NTP_SERVER>> } accept
    iifname $IF_DMZ counter jump drop_log                             # Rest: drop

    # --- LAB: isoliert, kein Internet, kein MGMT --------------------------
    iifname $IF_LAB oifname $IF_ANA accept                            # Logs/Flows
    iifname $IF_LAB oifname $IF_LAB accept                            # Intra-Lab
    iifname $IF_LAB counter jump drop_log

    # --- Analytics darf aus LAB/DMZ empfangen, selbst kaum Egress ---------
    iifname $IF_ANA oifname $IF_MGMT tcp dport { 22, 443 } \
      ip saddr $NET_ANA ip daddr @whitelist_admin accept

    # --- MGMT → interne Netze (Admin) -------------------------------------
    iifname $IF_MGMT oifname { $IF_DMZ, $IF_LAB, $IF_ANA } \
      ip saddr @whitelist_admin accept

    # --- OOB darf NIE geroutet werden -------------------------------------
    ip saddr $NET_OOB counter drop
    ip daddr $NET_OOB counter drop

    jump drop_log
  }

  chain output {
    type filter hook output priority filter; policy accept;
    # Optional: Host-Egress einschränken
  }

  chain drop_log {
    limit rate 10/second burst 20 packets \
      log prefix "nft-drop: " level warning
    counter drop
  }
}

# --- NAT (nur falls SEC-CORE SNAT für erlaubte Netze macht) ---------------
table ip nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    # Beispiel: Analytics darf Updates holen
    # oifname $IF_WAN ip saddr $NET_ANA masquerade
  }
}
